# ---- Database ----
# PostgreSQL is the primary database.
DATABASE_URL=postgresql+psycopg2://cove2e:cove2e@localhost:5432/cove2e
# For a quick local run without PostgreSQL you may use:
# DATABASE_URL=sqlite:///./cove2e.db

# ---- Sarvam AI (conversation, reasoning, translation, speech) ----
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai
SARVAM_CHAT_MODEL=sarvam-105b
SARVAM_STT_MODEL=saaras:v3
SARVAM_TRANSLATE_MODEL=sarvam-translate:v1
SARVAM_TTS_MODEL=bulbul:v2

# ---- Cognee (policy knowledge layer) ----
COGNEE_API_KEY=
COGNEE_ENABLED=false

# ---- n8n (workflow execution) ----
N8N_BASE_URL=http://localhost:5678
N8N_WEBHOOK_SECRET=change-me-n8n-secret
# URL n8n uses to call back into this backend (mock insurer + callbacks)
BACKEND_PUBLIC_URL=http://localhost:8000

# ---- Auth ----
JWT_SECRET=change-me-jwt-secret
JWT_EXPIRE_MINUTES=720

# ---- App ----
APP_ENV=development
DEMO_MODE=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10
