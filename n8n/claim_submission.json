      "typeVersion": 4.2,
      "position": [660, 200]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $('Prepare Claim Package').first().json.backend_url }}/mock-insurer/claims/{{ $json.external_claim_id }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
