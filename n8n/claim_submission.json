              "value": "={{ $env.COVE2E_WEBHOOK_SECRET }}"
            }
          ]
        },
        "options": {}
      },
      "id": "a1c0f6e2-0001-4c1a-9a01-000000000006",
      "name": "Fetch Insurer Acknowledgement",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [880, 200]
    },
    {
      "parameters": {
        "jsCode": "// Deterministic assembly of the response contract. No reasoning here.\nconst body = $('Webhook').first().json.body || {};\nconst submitted = $('Submit Claim to Insurer').first().json || {};\nconst snapshot = $('Fetch Insurer Acknowledgement').first().json || {};\nconst docCount = Array.isArray(body.documents) ? body.documents.length : 0;\n\nconst steps = [\n  {\n    key: 'prepare',\n    label: 'Preparing claim package',\n    status: 'DONE',\n    detail: `Claim ${body.claim_number || ''} (${body.product_type || ''}/${body.claim_type || ''}), amount ${body.claimed_amount ?? ''}, ${docCount} document(s)`\n  },\n  {\n    key: 'submit',\n    label: 'Submitting claim to insurer',\n    status: 'DONE',\n    detail: `Insurer reference ${submitted.external_claim_id || 'n/a'}`\n  },\n  {\n    key: 'acknowledge',\n    label: 'Fetching insurer acknowledgement',\n    status: 'DONE',\n    detail: `Status ${snapshot.status || 'UNKNOWN'}`\n  }\n];\n\nreturn [{\n  json: {\n    ok: true,\n    run_id: $execution.id,\n    workflow: 'COVE2E Claim Submission',\n    action_id: body.action_id,\n    journey_id: body.journey_id,\n    claim_id: body.claim_id,\n    external_claim_id: submitted.external_claim_id || snapshot.external_claim_id,\n    steps,\n    snapshot\n  }\n}];"
      },
      "id": "a1c0f6e2-0001-4c1a-9a01-000000000007",
      "name": "Build Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1100, 200]
    },
    {
      "parameters": {
        "respondWith": "json",
