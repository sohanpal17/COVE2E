      "id": "f6b5c1d7-0006-4c1a-9a06-000000000006",
      "name": "Schedule Trigger (every 30 min, disabled)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [440, 700],
      "disabled": true,
      "notes": "Disabled by default. Enable to poll the insurer every 30 minutes for the claim in COVE2E_POLL_CLAIM_ID."
    },
    {
      "parameters": {
        "jsCode": "// Resolve which claim to poll. Works for both the webhook path and the scheduled path.\nlet body = {};\ntry {\n  body = $('Webhook').first().json.body || {};\n} catch (e) {\n  body = {};\n}\n\nconst fromWebhook = Boolean(body && body.external_claim_id);\nconst backend_url = body.backend_url || $env.COVE2E_BACKEND_URL || 'http://backend:8000';\nconst external_claim_id = body.external_claim_id || $env.COVE2E_POLL_CLAIM_ID || '';\n\nif (!external_claim_id) {\n  throw new Error('external_claim_id missing. For scheduled polling set COVE2E_POLL_CLAIM_ID in the n8n environment.');\n}\n\nreturn [{\n  json: {\n    backend_url,\n    external_claim_id,\n    from_webhook: fromWebhook,\n    action_type: body.action_type || 'POLL_STATUS',\n    expected_status: body.expected_status || null\n  }\n}];"
      },
      "id": "f6b5c1d7-0006-4c1a-9a06-000000000007",
      "name": "Resolve Target Claim",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [880, 400]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $json.backend_url }}/mock-insurer/claims/{{ $json.external_claim_id }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-COVE2E-Secret",
              "value": "={{ $env.COVE2E_WEBHOOK_SECRET }}"
            }
          ]
        },
        "options": {}
      },
      "id": "f6b5c1d7-0006-4c1a-9a06-000000000008",
      "name": "Get Claim Status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1100, 400]
    },
    {
      "parameters": {
        "jsCode": "// Assemble steps in UI order.\nconst target = $('Resolve Target Claim').first().json;\nconst snapshot = $input.first().json || {};\n\nlet body = {};\ntry { body = $('Webhook').first().json.body || {}; } catch (e) { body = {}; }\n\nlet followUp = null;\ntry { followUp = $('Raise Follow-up Query').first().json; } catch (e) { followUp = null; }\n\nconst steps = [];\n\nif (followUp) {\n  steps.push({\n    key: 'follow_up',\n    label: 'Raising follow-up with insurer',\n    status: 'DONE',\n    detail: body.message ? `Sent: \"${body.message}\"` : 'Follow-up query sent to insurer'\n  });\n}\n\nconst expected = target.expected_status;\nlet detail = `Status ${snapshot.status || 'UNKNOWN'}`;\nif (snapshot.settlement_status) detail += `, settlement ${snapshot.settlement_status}`;\nif (snapshot.payment_status) detail += `, payment ${snapshot.payment_status}`;\nif (expected) detail += expected === snapshot.status ? ' (as expected)' : ` (expected ${expected})`;\n\nsteps.push({\n  key: 'poll',\n  label: 'Polling insurer status',\n  status: 'DONE',\n  detail\n});\n\nreturn [{\n  json: {\n    ok: true,\n    run_id: $execution.id,\n    workflow: 'COVE2E Status Polling & Follow-up',\n    action_id: body.action_id || null,\n    action_type: target.action_type,\n    journey_id: body.journey_id || null,\n    claim_id: body.claim_id || null,\n    external_claim_id: target.external_claim_id,\n    from_webhook: target.from_webhook,\n    status_changed: expected ? expected !== snapshot.status : null,\n    steps,\n    snapshot\n  }\n}];"
      },
      "id": "f6b5c1d7-0006-4c1a-9a06-000000000009",
