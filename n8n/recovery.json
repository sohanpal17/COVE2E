          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "b2d1e7f3-0002-4c1a-9a02-000000000008",
      "name": "Should Attach?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1100, 200]
    },
    {
      "parameters": {
        "jsCode": "// One item per document so the HTTP node attaches each one.\nconst body = $('Webhook').first().json.body || {};\nconst docs = Array.isArray(body.documents) ? body.documents : [];\nconst backend_url = body.backend_url || $env.COVE2E_BACKEND_URL;\n\nreturn docs.map(d => ({\n  json: {\n    document_id: d.document_id,\n    document_type: d.document_type || body.document_type,\n    file_name: d.file_name,\n    external_claim_id: body.external_claim_id,\n    backend_url\n  }\n}));"
      },
      "id": "b2d1e7f3-0002-4c1a-9a02-000000000009",
      "name": "Split Documents",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1320, 100]
    },
