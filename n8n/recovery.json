        "url": "={{ $('Prepare Recovery').first().json.backend_url }}/mock-insurer/claims/{{ $('Prepare Recovery').first().json.external_claim_id }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-COVE2E-Secret",
              "value": "={{ $env.COVE2E_WEBHOOK_SECRET }}"
            }
          ]
        },
        "options": {}
      },
      "id": "b2d1e7f3-0002-4c1a-9a02-000000000014",
      "name": "Get Claim",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2420, 300]
    },
    {
      "parameters": {
        "jsCode": "// Assemble steps in UI order. Branch nodes that did not run are skipped safely.\nconst body = $('Webhook').first().json.body || {};\nconst plan = $('Prepare Recovery').first().json;\nconst validation = $('Validate Document').first().json;\nconst snapshot = $input.first().json || {};\n\nfunction safe(nodeName) {\n  try { return $(nodeName).first().json; } catch (e) { return null; }\n}\n\nconst attach = plan.should_attach ? safe('Collect Attachments') : null;\nconst resubmit = plan.should_resubmit ? safe('Resubmit Claim') : null;\n\nconst steps = [\n  {\n    key: 'prepare',\n    label: 'Preparing recovery',\n    status: 'DONE',\n    detail: `Action ${body.action_type} for claim ${body.external_claim_id}`\n  },\n  {\n    key: 'validate',\n    label: 'Validating document',\n    status: 'DONE',\n    detail: plan.should_attach\n      ? `${validation.document_count} document(s) checked: ${(validation.document_types || []).join(', ') || 'none'}`\n      : 'No new documents required for resubmission'\n  }\n];\n\nif (attach) {\n  steps.push({\n    key: 'attach',\n    label: 'Attaching document',\n    status: 'DONE',\n    detail: `${attach.attached_count} document(s) attached to ${body.external_claim_id}`\n  });\n}\n\nif (resubmit) {\n  steps.push({\n    key: 'resubmit',\n    label: 'Resubmitting claim',\n    status: 'DONE',\n    detail: `Insurer status ${resubmit.status || snapshot.status || 'UNKNOWN'}`\n  });\n}\n\nsteps.push({\n  key: 'snapshot',\n  label: 'Fetching insurer status',\n  status: 'DONE',\n  detail: `Status ${snapshot.status || 'UNKNOWN'}`\n});\n\nreturn [{\n  json: {\n    ok: true,\n    run_id: $execution.id,\n    workflow: 'COVE2E Recovery (attach + resubmit)',\n    action_id: body.action_id,\n    action_type: body.action_type,\n    journey_id: body.journey_id,\n    claim_id: body.claim_id,\n    external_claim_id: body.external_claim_id,\n    steps,\n    snapshot\n  }\n}];"
      },
