      "id": "b2d1e7f3-0002-4c1a-9a02-000000000004",
      "name": "Prepare Recovery",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [440, 300]
    },
    {
      "parameters": {
        "jsCode": "// Deterministic validation only. Fails when attaching is required but no usable document exists.\nconst body = $('Webhook').first().json.body || {};\nconst plan = $('Prepare Recovery').first().json;\nconst docs = Array.isArray(body.documents) ? body.documents : [];\n\nlet valid = true;\nlet error = null;\n\nif (plan.should_attach) {\n  if (docs.length === 0) {\n    valid = false;\n    error = 'no documents supplied for attachment';\n  } else {\n    const bad = docs.find(d => String(d.validation_status || '').toUpperCase() === 'INVALID');\n    if (bad) {\n      valid = false;\n      error = `document ${bad.file_name || bad.document_id} has validation_status INVALID`;\n    }\n  }\n}\n\nreturn [{\n  json: {\n    ok: valid,\n    valid,\n    error,\n    document_count: docs.length,\n    document_types: docs.map(d => d.document_type),\n    should_attach: plan.should_attach,\n    should_resubmit: plan.should_resubmit\n  }\n}];"
      },
      "id": "b2d1e7f3-0002-4c1a-9a02-000000000005",
      "name": "Validate Document",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [660, 300]
    },
