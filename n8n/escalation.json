      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1320, 200]
    },
    {
      "parameters": {
        "content": "## COVE2E Escalation\nCreates a ticket object { reference: 'ESC-<timestamp>', problem, journey_id, claim_id, ... } and hands it to a human agent.\n\nThe agent-notification HTTP node is a disabled placeholder; enable it and set COVE2E_ESCALATION_WEBHOOK_URL to route to Slack/Teams/ticketing.",
        "height": 200,
        "width": 440
      },
