            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "id": "e5a4b0c6-0005-4c1a-9a05-000000000006",
      "name": "Mark Agent Notified",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [880, 200]
    },
    {
      "parameters": {
        "jsCode": "const body = $('Webhook').first().json.body || {};\nconst ticket = $input.first().json || {};\n\nconst steps = [\n  {\n    key: 'ticket',\n    label: 'Creating escalation ticket',\n    status: 'DONE',\n    detail: `Ticket ${ticket.reference} created (${ticket.priority})`\n  },\n  {\n    key: 'notify',\n    label: 'Notifying human agent',\n    status: 'DONE',\n    detail: `Routed to ${ticket.assigned_to}`\n  }\n];\n\nreturn [{\n  json: {\n    ok: true,\n    run_id: $execution.id,\n    workflow: 'COVE2E Escalation',\n    action_id: body.action_id,\n    journey_id: body.journey_id,\n    claim_id: body.claim_id,\n    steps,\n    ticket,\n    snapshot: null\n  }\n}];"
      },
      "id": "e5a4b0c6-0005-4c1a-9a05-000000000007",
      "name": "Build Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1100, 200]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($json) }}",
